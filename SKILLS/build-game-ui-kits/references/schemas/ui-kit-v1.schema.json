{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openai.local/build-game-ui-kits/ui-kit-v1.schema.json",
  "title": "Raster UI kit v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "kit_id", "style_fingerprint", "densities", "tokens", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "game-ui-raster-kit"},
    "kit_id": {"$ref": "#/$defs/id"},
    "style_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "densities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4}},
    "tokens": {
      "type": "object", "additionalProperties": false,
      "required": ["foreground", "background", "minimum_contrast"],
      "properties": {
        "foreground": {"$ref": "#/$defs/color"},
        "background": {"$ref": "#/$defs/color"},
        "minimum_contrast": {"type": "number", "minimum": 1, "maximum": 21}
      }
    },
    "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_type", "art_engine", "fixture", "verification_status"],
      "properties": {
        "source_type": {"enum": ["imagegen", "grok-imagine-image", "imported", "fixture"]},
        "art_engine": {"enum": ["imagegen", "grok-imagine", "imported", "fixture"]},
        "fixture": {"type": "boolean"},
        "verification_status": {"const": "verified"},
        "provider_record": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
        }
      },
      "oneOf": [
        {"properties": {"source_type": {"const": "imagegen"}, "art_engine": {"const": "imagegen"}, "fixture": {"const": false}}},
        {"properties": {"source_type": {"const": "grok-imagine-image"}, "art_engine": {"const": "grok-imagine"}, "fixture": {"const": false}}, "required": ["provider_record"]},
        {"properties": {"source_type": {"const": "imported"}, "art_engine": {"const": "imported"}, "fixture": {"const": false}}},
        {"properties": {"source_type": {"const": "fixture"}, "art_engine": {"const": "fixture"}, "fixture": {"const": true}}}
      ]
    },
    "state": {"enum": ["default", "hover", "pressed", "disabled", "selected", "focused", "active"]},
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["density", "path", "sha256", "provenance"],
      "properties": {
        "density": {"type": "integer", "minimum": 1, "maximum": 4},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "provenance": {"$ref": "#/$defs/sourceProvenance"}
      }
    },
    "rect": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "nineSlice": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "top", "right", "bottom", "content_safe"],
      "properties": {
        "left": {"type": "integer", "minimum": 1},
        "top": {"type": "integer", "minimum": 1},
        "right": {"type": "integer", "minimum": 1},
        "bottom": {"type": "integer", "minimum": 1},
        "content_safe": {"$ref": "#/$defs/rect"}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "base_size", "required_states", "states"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["button", "panel", "bar", "icon", "cursor", "badge", "frame", "toggle"]},
        "base_size": {
          "type": "object", "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "required_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/state"}},
        "states": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/state"},
          "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}}
        },
        "nine_slice": {"$ref": "#/$defs/nineSlice"}
      }
    }
  }
}
