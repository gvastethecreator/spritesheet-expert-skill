{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openai.local/compose-asset-mockups/licenses.schema.json",
  "title": "Presentation license registry",
  "type": "array",
  "minItems": 1,
  "items": {"$ref": "#/$defs/license"},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/]|[\\\\/]).+"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "terms", "status", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "terms": {"type": "string", "minLength": 1},
        "status": {"const": "closed"},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/path"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    }
  }
}
