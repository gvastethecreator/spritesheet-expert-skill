{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openai.local/compose-asset-mockups/manifest.schema.json",
  "title": "Presentation delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["outputs"],
  "properties": {
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/output"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/]|[\\\\/]).+"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "composition_id", "path", "media_type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "composition_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/path"},
        "media_type": {"const": "image/png"}
      }
    }
  }
}
