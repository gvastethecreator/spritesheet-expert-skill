{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openai.local/produce-2d-assets/delivery-manifest.schema.json",
  "title": "2D asset delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["deliverables"],
  "properties": {
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/deliverable"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "owner", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "asset_id": {"$ref": "#/$defs/id"},
        "variant_id": {"$ref": "#/$defs/id"},
        "owner": {"$ref": "#/$defs/id"},
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:[\\\\/]|[\\\\/]).+"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
