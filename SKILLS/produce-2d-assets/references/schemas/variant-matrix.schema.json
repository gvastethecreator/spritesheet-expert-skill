{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openai.local/produce-2d-assets/variant-matrix.schema.json",
  "title": "2D asset variant matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["axes", "variants"],
  "properties": {
    "axes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/axis_value"}
      }
    },
    "variants": {
      "type": "array",
      "items": {"$ref": "#/$defs/variant"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "axis_value": {
      "type": ["string", "number", "integer", "boolean"]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "axes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "asset_id": {"$ref": "#/$defs/id"},
        "axes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/axis_value"
          }
        }
      }
    }
  }
}
