{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openai.local/compose-asset-mockups/provenance.schema.json",
  "title": "Presentation provenance registry",
  "type": "array",
  "minItems": 1,
  "items": {"$ref": "#/$defs/provenance"},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/]|[\\\\/]).+"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "asset_id", "truth_type", "source_path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "asset_id": {"$ref": "#/$defs/id"},
        "truth_type": {"enum": ["concept", "reconstructed", "runtime-captured"]},
        "source_path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capture_evidence": {
          "$ref": "https://schemas.openai.local/compose-asset-mockups/capture-evidence.schema.json"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"truth_type": {"const": "runtime-captured"}}},
          "then": {"required": ["capture_evidence"]}
        }
      ]
    }
  }
}
