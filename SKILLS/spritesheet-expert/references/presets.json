    "tileset-topdown": {
      "description": "Top-down tilemap atlas for terrain, paths, water, walls, cliffs, and decor.",
      "camera": "topdown-tile",
      "asset_kind": "tileset",
      "extraction_mode": "slots",
      "art_profiles": ["pixel-core", "pixel-texture", "pixel-topdown"],
      "style": "game-ready top-down tilemap art, consistent grid scale, coherent palette, clean readable materials, tileable edges where the row action asks for them.",
      "cell": { "width": 64, "height": 64, "safe_margin": 0 },
      "columns": 8,
      "transparent": true,
      "formats": ["png", "webp"],
      "output": { "use": "tilemap", "frame_semantics": "tiles" },
      "rows": [
        { "id": "terrain", "frames": 8, "fps": 1, "loop": false, "action": "top-down grass, dirt, stone, sand, mud, snow, and cracked ground tile variants with compatible edges" },
        { "id": "paths", "frames": 8, "fps": 1, "loop": false, "action": "top-down path and road tiles: straight, corner, tee, cross, endcap, bridge, and worn variants" },
        { "id": "water", "frames": 8, "fps": 1, "loop": false, "action": "top-down water, shoreline, foam, pond, river, and wet edge tiles with consistent palette" },
        { "id": "walls", "frames": 8, "fps": 1, "loop": false, "action": "top-down wall, fence, cliff, ledge, gate, and obstacle tiles with readable collision edges" },
        { "id": "decor", "frames": 8, "fps": 1, "loop": false, "action": "small top-down decor tiles: rocks, flowers, shrubs, crates, signs, debris, and ground decals" }
      ]
    },
    "tileset-platformer": {
      "description": "Side-view platformer tileset atlas for ground, slopes, ledges, hazards, backgrounds, and decor.",
      "camera": "side-tile",
      "asset_kind": "tileset",
      "extraction_mode": "slots",
      "art_profiles": ["pixel-core", "pixel-texture", "pixel-sideview"],
      "style": "game-ready side-view platformer tileset art, consistent tile grid, readable silhouettes, coherent palette, strong collision surfaces.",
      "cell": { "width": 64, "height": 64, "safe_margin": 0 },
      "columns": 8,
      "transparent": true,
      "formats": ["png", "webp"],
      "output": { "use": "platformer-tilemap", "frame_semantics": "tiles" },
      "rows": [
        { "id": "ground", "frames": 8, "fps": 1, "loop": false, "action": "solid ground tiles: center, top, side, corner, inner corner, cap, and broken variants" },
        { "id": "slopes", "frames": 8, "fps": 1, "loop": false, "action": "platformer slope and ramp tiles with clean collision-readable silhouettes" },
        { "id": "ledges", "frames": 8, "fps": 1, "loop": false, "action": "platform, bridge, one-way ledge, hanging edge, cracked ledge, and support tiles" },
        { "id": "hazards", "frames": 8, "fps": 1, "loop": false, "action": "spikes, lava edge, thorns, saw base, acid, and warning hazard tiles, all readable at runtime" },
        { "id": "decor", "frames": 8, "fps": 1, "loop": false, "action": "side-view decorative tiles: grass tufts, vines, signs, rocks, chains, background trims, and decals" }
      ]
    },
    "texture-pack": {
      "description": "Seamless material texture atlas for terrain, props, and environment surfaces.",
      "camera": "material-flat",
      "asset_kind": "texture",
      "extraction_mode": "slots",
      "art_profiles": ["pixel-core", "pixel-texture"],
      "style": "game-ready seamless material textures, orthographic flat samples, no labels, no perspective scene, consistent texel density and lighting.",
      "cell": { "width": 128, "height": 128, "safe_margin": 0 },
      "columns": 6,
      "transparent": false,
      "formats": ["png", "webp"],
      "output": { "use": "materials", "frame_semantics": "seamless-textures" },
      "rows": [
        { "id": "stone", "frames": 6, "fps": 1, "loop": false, "action": "seamless stone material samples: rough block, cracked slate, cobble, carved tile, wet stone, and mossy stone" },
        { "id": "wood", "frames": 6, "fps": 1, "loop": false, "action": "seamless wood material samples: plank, bark, worn board, dark beam, painted wood, and splintered wood" },
        { "id": "metal", "frames": 6, "fps": 1, "loop": false, "action": "seamless metal material samples: clean steel, rust, brass, scratched plate, riveted panel, and dark iron" },
        { "id": "fabric", "frames": 6, "fps": 1, "loop": false, "action": "seamless fabric material samples: canvas, wool, leather, stitched cloth, banner weave, and padded textile" },
        { "id": "ground", "frames": 6, "fps": 1, "loop": false, "action": "seamless ground material samples: soil, sand, snow, grass, gravel, and mud" }
      ]
    },
    "asset-pack": {
      "description": "Mixed still asset atlas for props, pickups, UI icons, VFX, and decals.",
      "camera": "asset",
      "asset_kind": "asset",
      "extraction_mode": "slots",
      "art_profiles": ["pixel-core", "pixel-texture", "pixel-items-ui", "pixel-vfx"],
      "style": "game-ready isolated asset art, consistent palette, scale, outline weight, and runtime readability.",
      "cell": { "width": 128, "height": 128, "safe_margin": 8 },
      "columns": 8,
      "transparent": true,
      "formats": ["png", "webp"],
      "output": { "use": "mixed-assets", "frame_semantics": "still-assets" },
      "rows": [
        { "id": "props", "frames": 8, "fps": 1, "loop": false, "action": "environment props: crate, barrel, lantern, sign, plant, rock, tool, and furniture item, isolated per slot" },
        { "id": "pickups", "frames": 8, "fps": 1, "loop": false, "action": "pickup items: coin, gem, potion, key, scroll, food, ammo, and power-up, isolated per slot" },
        { "id": "ui-icons", "frames": 8, "fps": 1, "loop": false, "action": "runtime UI icons: heart, shield, sword, map, bag, gear, star, and alert marker, isolated per slot" },
        { "id": "vfx", "frames": 8, "fps": 1, "loop": false, "action": "self-contained VFX stills: impact, spark, smoke puff, flame burst, magic glint, slash arc, splash, and dust ring" },
        { "id": "decals", "frames": 8, "fps": 1, "loop": false, "action": "ground and wall decals: crack, scorch, footprint, stain, moss patch, arrow mark, scrape, and rune mark" }
      ]
    },
    "custom-asset-atlas": {
