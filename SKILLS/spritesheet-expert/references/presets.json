{
  "version": 1,
  "presets": {
    "codex-pet": {
      "description": "Codex custom pet atlas compatible with hatch-pet output.",
      "camera": "mascot",
      "art_profiles": ["pixel-core", "pixel-character", "pixel-motion"],
      "cell": { "width": 192, "height": 208, "safe_margin_x": 18, "safe_margin_y": 16 },
      "columns": 8,
      "transparent": true,
      "formats": ["webp", "png"],
      "compatibility": ["codex-custom-pet"],
      "rows": [
        { "id": "idle", "frames": 6, "durations_ms": [280, 110, 110, 140, 140, 320] },
        { "id": "running-right", "frames": 8, "durations_ms": [120, 120, 120, 120, 120, 120, 120, 220], "mirror_pair": "running-left" },
        { "id": "running-left", "frames": 8, "durations_ms": [120, 120, 120, 120, 120, 120, 120, 220], "mirror_pair": "running-right" },
        { "id": "waving", "frames": 4, "durations_ms": [140, 140, 140, 280] },
        { "id": "jumping", "frames": 5, "durations_ms": [140, 140, 140, 140, 280] },
        { "id": "failed", "frames": 8, "durations_ms": [140, 140, 140, 140, 140, 140, 140, 240] },
        { "id": "waiting", "frames": 6, "durations_ms": [150, 150, 150, 150, 150, 260] },
        { "id": "running", "frames": 6, "durations_ms": [120, 120, 120, 120, 120, 220] },
        { "id": "review", "frames": 6, "durations_ms": [150, 150, 150, 150, 150, 280] }
      ]
    },
