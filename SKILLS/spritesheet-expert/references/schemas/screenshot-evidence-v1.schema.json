{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spritesheet-expert.local/schemas/screenshot-evidence-v1.schema.json",
  "title": "Spritesheet Expert screenshot evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "evidence_kind",
    "applicable",
    "artifact",
    "sources",
    "input_fingerprint",
    "state",
    "frames",
    "durations_ms",
    "viewport",
    "renderer",
    "color_space",
    "background",
    "sampling",
    "overlays",
    "placements",
    "captured_at"
  ],
  "properties": {
    "version": {"const": 1},
    "kind": {"const": "screenshot-evidence"},
    "evidence_kind": {
      "enum": [
        "runtime-still",
        "runtime-playback",
        "contact-sheet",
        "onion-skin",
        "matte-review",
        "tile-repeat",
        "tile-map",
        "isometric-depth",
        "background-parallax",
        "ui-state-board",
        "ui-stretch-board",
        "presentation-native",
        "presentation-thumbnail",
        "presentation-mask-review"
      ]
    },
    "applicable": {"const": true},
    "artifact": {"$ref": "#/$defs/fileArtifact"},
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/sourceArtifact"}
    },
    "input_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "state": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "durations_ms": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "dpr"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "dpr": {"type": "number", "minimum": 0.5, "maximum": 4}
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "spritesheet-expert-pillow-runtime-preview"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "color_space": {"const": "sRGB"},
    "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "sampling": {"enum": ["nearest", "linear"]},
    "overlays": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/placement"}
    },
    "captured_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/]|[\\\\/]).+"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type", "width", "height"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "media_type": {"enum": ["image/png", "image/gif"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes"],
      "properties": {
        "role": {"enum": ["manifest", "atlas", "tilemap", "layout", "scene"]},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "x", "y", "width", "height", "source_rect"],
      "properties": {
        "frame": {"type": "integer", "minimum": 0},
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "source_rect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": {"type": "integer", "minimum": 0},
            "y": {"type": "integer", "minimum": 0},
            "w": {"type": "integer", "minimum": 1},
            "h": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
