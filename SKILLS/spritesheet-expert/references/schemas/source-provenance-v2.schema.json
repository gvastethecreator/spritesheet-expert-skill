{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spritesheet-expert.local/schemas/source-provenance-v2.schema.json",
  "title": "Spritesheet Expert source provenance v2",
  "type": "object",
  "required": [
    "version",
    "kind",
    "source_type",
    "art_engine",
    "fixture",
    "verification_status",
    "accepted_sources",
    "state_coverage"
  ],
  "properties": {
    "version": { "const": 2 },
    "kind": { "const": "sprite-source-provenance" },
    "source_type": { "enum": ["imagegen", "imported", "fixture"] },
    "art_engine": { "enum": ["imagegen", "imported", "fixture"] },
    "fixture": { "type": "boolean" },
    "verification_status": { "enum": ["verified", "legacy-unverified"] },
    "accepted_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "state_coverage": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateSlug" }
    },
    "notes": { "type": "string" },
    "license": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "stateSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "states"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stateSlug" }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "source_type": { "const": "imagegen" },
            "art_engine": { "const": "imagegen" },
            "fixture": { "const": false }
          },
          "required": ["source_type", "art_engine", "fixture"]
        },
        {
          "properties": {
            "source_type": { "const": "imported" },
            "art_engine": { "const": "imported" },
            "fixture": { "const": false }
          },
          "required": ["source_type", "art_engine", "fixture"]
        },
        {
          "properties": {
            "source_type": { "const": "fixture" },
            "art_engine": { "const": "fixture" },
            "fixture": { "const": true }
          },
          "required": ["source_type", "art_engine", "fixture"]
        }
      ]
    },
    {
      "if": {
        "properties": { "verification_status": { "const": "verified" } },
        "required": ["verification_status"]
      },
      "then": {
        "properties": {
          "accepted_sources": {
            "items": {
              "properties": {
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "size_bytes": { "type": "integer", "minimum": 1 },
                "states": { "minItems": 1 }
              }
            }
          },
          "state_coverage": { "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
