{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spritesheet-expert.local/schemas/sprite-manifest-v2.schema.json",
  "title": "Spritesheet Expert runtime manifest v2",
  "type": "object",
  "required": ["version", "kind", "asset_kind", "frame_semantics", "atlas", "cell", "frame_layout", "sampling_policy"],
  "properties": {
    "version": { "const": 2 },
    "kind": { "const": "sprite-atlas-manifest" },
    "asset_kind": { "enum": ["sprite", "tileset", "texture", "asset", "prop", "icon", "ui", "vfx"] },
    "frame_semantics": { "enum": ["animation", "variants", "tiles", "seamless-textures", "still-assets", "effects", "user-defined"] },
    "atlas": {
      "type": "object",
      "required": ["path", "width", "height"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "cell": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "frame_layout": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/rect" }
          }
        }
      },
      "additionalProperties": true
    },
    "sampling_policy": { "$ref": "#/$defs/samplingPolicy" }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "w": { "type": "integer", "minimum": 1 },
        "h": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "samplingPolicy": {
      "type": "object",
      "required": ["filter", "wrap", "mipmaps", "pixel_snap"],
      "properties": {
        "filter": { "enum": ["nearest", "linear"] },
        "wrap": { "enum": ["clamp-to-edge", "repeat", "mirror-repeat"] },
        "mipmaps": { "type": "boolean" },
        "pixel_snap": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
