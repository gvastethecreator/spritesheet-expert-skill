{
  "name": "spritesheet-expert-skill",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "setup": "python -m pip install -e .",
    "setup:test": "python -m pip install -e \".[test]\"",
    "doctor": "python scripts/check_python_env.py",
    "doctor:test": "python scripts/check_python_env.py --test",
    "check": "pnpm run doctor:test && pnpm run validate && pnpm test && pnpm run smoke",
    "pretest": "node -e \"require('node:fs').mkdirSync('.scratch', { recursive: true })\"",
    "test": "python -m pytest -p no:cacheprovider --basetemp .scratch/pytest",
    "validate": "node scripts/validate-skill-pack.mjs && pnpm run validate:evals && pnpm run validate:motion-templates",
    "validate:evals": "node scripts/validate-routing-evals.mjs",
    "validate:motion-templates": "python SKILLS/spritesheet-expert/scripts/check_motion_template_library.py --template-root SKILLS/spritesheet-expert/assets/motion-reference-templates --allow-pending",
    "smoke": "python ./SKILLS/spritesheet-expert/scripts/smoke_pipeline.py"
  }
}
